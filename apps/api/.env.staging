# ─────────────────────────────────────────────
# BFF — apps/api — STAGING
# ─────────────────────────────────────────────
NODE_ENV=staging
PORT=3001
FRONTEND_URL=https://staging.usepdc.com
API_URL=https://api-staging.usepdc.com

CORS_ORIGINS=https://staging.usepdc.com

# ⚠️ BYPASS DE OTP (can be enabled for staging E2E tests)
DEV_SKIP_OTP=false

# JWT
JWT_SECRET=

# Strapi CMS (staging instance)
STRAPI_URL=https://strapi-staging.usepdc.com
STRAPI_API_TOKEN=

# Upstash Redis (separate staging instance)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api-staging.usepdc.com/auth/google/callback

# LinkedIn OAuth 2.0
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://api-staging.usepdc.com/auth/linkedin/callback

# OAuth Redirect (Frontend)
OAUTH_REDIRECT_BASE_URL=https://staging.usepdc.com

# SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@usepdc.com

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Cloudflare R2 (separate staging bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=pdc-media-staging
R2_PUBLIC_URL=

# DeepSeek AI
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# LTI 1.3
LTI_PRIVATE_KEY=
LTI_PUBLIC_KEY=
LTI_KEY_ID=pdc-lti-key-1

# Sentry APM (staging project)
SENTRY_DSN=
