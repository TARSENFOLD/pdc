# ─────────────────────────────────────────────
# BFF — apps/api (Por Dentro do Curso)
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3001

# ⚠️ BYPASS DE OTP (Apenas para Desenvolvimento)
# Define como 'true' para saltar a verificação de OTP no login/registo local.
# Requer NODE_ENV != production e STRAPI_URL não-produção.
DEV_SKIP_OTP=false

# JWT (Mínimo 32 caracteres em produção)
JWT_SECRET=mudar-em-producao-pdc-bff-secret-key-2024

# Strapi CMS (Domínio local: http://localhost:1337)
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=obter_no_painel_admin_do_strapi

# Upstash Redis (Rate limiting + Refresh tokens + Challenges)
UPSTASH_REDIS_REST_URL=https://[seu-endpoint].upstash.io
UPSTASH_REDIS_REST_TOKEN=[seu-token]

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# LinkedIn OAuth 2.0
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3001/auth/linkedin/callback

# OAuth Redirect Base URL (Frontend)
OAUTH_REDIRECT_BASE_URL=http://localhost:3000

# SendGrid (Email OTP)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@usepdc.com

# Twilio (SMS OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Cloudflare R2 (Media Storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# DeepSeek AI (Tutor Vocacional)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Ollama (Fallback IA Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# LTI 1.3
LTI_PRIVATE_KEY=
LTI_PUBLIC_KEY=
LTI_KEY_ID=pdc-lti-key-1

# Sentry
SENTRY_DSN=
