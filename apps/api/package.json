{
  "name": "@pdc/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "test": "vitest",
    "dev": "tsx watch --env-file=.env --import ./src/instrument.ts src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --import ./dist/src/instrument.js dist/src/index.js",
    "start:consumer": "node --import ./dist/src/instrument.js dist/src/modules/telemetria/consumer.js",
    "worker:telemetry": "node --import ./dist/src/instrument.js dist/src/workers/telemetry-worker.js",
    "worker:telemetry:dev": "tsx watch --env-file=.env --import ./src/instrument.ts src/workers/telemetry-worker.ts",
    "start:outbox-worker": "node --import ./dist/src/instrument.js dist/src/modules/outbox/outbox-worker.js",
    "replay-outbox": "node --import ./dist/src/instrument.js dist/src/modules/outbox/outbox-worker.js",
    "provision:internal-account": "node dist/src/cli/provision-internal-account.js",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache . --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@hono/node-server": "^1.19.13",
    "@hono/zod-validator": "^0.4.0",
    "@pdc/shared": "*",
    "@sentry/node": "^10.47.0",
    "@sentry/profiling-node": "^10.47.0",
    "@upstash/ratelimit": "^2.0.0",
    "@upstash/redis": "^1.34.0",
    "file-type": "^21.3.4",
    "hono": "^4.12.18",
    "jose": "^5.9.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "redis": "^6.1.0",
    "resend": "^6.12.0",
    "socket.io": "^4.8.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.0",
    "@sentry/cli": "^2.58.6",
    "@types/node": "^22.0.0",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^9.11.0",
    "prettier": "^3.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.7.0",
    "vitest": "^4.1.4"
  }
}
