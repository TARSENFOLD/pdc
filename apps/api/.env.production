# ─────────────────────────────────────────────
# BFF — apps/api — PRODUCTION
# ─────────────────────────────────────────────
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://usepdc.com
API_URL=https://api.usepdc.com

CORS_ORIGINS=https://usepdc.com,https://www.usepdc.com

# JWT (min 32 chars, generate with: openssl rand -base64 48)
JWT_SECRET=

# Strapi CMS
STRAPI_URL=https://strapi.usepdc.com
STRAPI_API_TOKEN=

# Upstash Redis (REQUIRED in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.usepdc.com/auth/google/callback

# LinkedIn OAuth 2.0
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://api.usepdc.com/auth/linkedin/callback

# OAuth Redirect (Frontend)
OAUTH_REDIRECT_BASE_URL=https://usepdc.com

# SendGrid (Email OTP)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@usepdc.com

# Twilio (SMS OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Cloudflare R2 (Media Storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=pdc-media-prod
R2_PUBLIC_URL=

# DeepSeek AI
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# LTI 1.3
LTI_PRIVATE_KEY=
LTI_PUBLIC_KEY=
LTI_KEY_ID=pdc-lti-key-1

# Sentry APM
SENTRY_DSN=
