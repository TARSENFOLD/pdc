    "actorRole": { "type": "string" },
    "alvoId": { "type": "string" },
    "alvoTipo": { "type": "string" },
    "detalhes": { "type": "json" },
    "ipHash": { "type": "string" },
    "userAgent": { "type": "string" },
    "serverTimestamp": { "type": "datetime" },
    "autor": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::perfil.perfil"
    }
  }
}
