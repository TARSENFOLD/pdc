{
  "kind": "collectionType",
  "collectionName": "projetos",
  "info": {
    "singularName": "projeto",
    "pluralName": "projetos",
    "displayName": "Projeto"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "slug": { "type": "uid", "targetField": "titulo", "unique": true },
    "titulo": { "type": "string", "required": true },
    "descricao": { "type": "text" },
    "abstract": { "type": "json" },
    "core": { "type": "json" },
    "modos": { "type": "json" },
    "selo": {
      "type": "enumeration",
      "enum": ["aptidao_validada", "comite_aprovado", "mentor_endorsed"]
    },
    "area": {
      "type": "enumeration",
      "enum": [
        "SAUDE", "ENGENHARIA", "TECNOLOGIA", "DIREITO", "GESTAO",
        "EDUCACAO", "ARTES", "CIENCIAS_AGRARIAS", "CIENCIAS_SOCIAIS",
        "COMUNICACAO", "CIENCIAS_NATURAIS", "ARQUITETURA",
        "TURISMO_HOTELARIA", "DESPORTO", "OUTRA"
      ]
    },
    "estado": {
      "type": "enumeration",
      "enum": ["draft", "review", "approved", "published", "archived"],
      "default": "draft"
    },
    "autor": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::perfil.perfil"
    },
    "colaboradores": { "type": "json" },
    "tags": { "type": "json" },
    "mediaUrls": { "type": "json" },
    "repositorioUrl": { "type": "string" },
    "visibilidade": {
      "type": "enumeration",
      "enum": ["publico", "privado"],
      "default": "publico"
    },
    "buscandoParceiros": { "type": "boolean", "default": false },
    "criadoEm": { "type": "datetime" },
    "pedidosAcesso": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::projeto-acesso-pedido.projeto-acesso-pedido",
      "mappedBy": "projeto"
    }
  }
}
