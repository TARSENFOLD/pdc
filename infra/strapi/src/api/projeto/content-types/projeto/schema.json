{
  "kind": "collectionType",
  "collectionName": "projetos",
  "info": {
    "singularName": "projeto",
    "pluralName": "projetos",
    "displayName": "Projeto"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "slug": { "type": "uid", "targetField": "titulo", "unique": true },
    "titulo": { "type": "string", "required": true },
    "descricao": { "type": "text", "description": "⚠️ DEPRECATED — usar abstract. Mantido por retrocompatibilidade." },
    "abstract": { "type": "text", "description": "Resumo público do projeto (camada pública)" },
    "core": { "type": "text", "description": "Detalhes privados do projeto (camada core) — acesso controlado por ACL" },
    "modos": { "type": "json", "description": "Modos do projeto: exposicao, colaboracao, mentoria, financiamento" },
    "acessoCoreACL": { "type": "json", "description": "ACL de acesso ao core: lista de perfis aprovados" },
    "votos": { "type": "json", "description": "Sistema de votos/endorsamentos do projeto" },
    "historicoEstados": { "type": "json", "description": "Audit trail de transições de estado editorial" },
    "area": {
      "type": "enumeration",
      "enum": [
        "SAUDE", "ENGENHARIA", "TECNOLOGIA", "DIREITO", "GESTAO",
        "EDUCACAO", "ARTES", "CIENCIAS_AGRARIAS", "CIENCIAS_SOCIAIS",
        "COMUNICACAO", "CIENCIAS_NATURAIS", "ARQUITETURA",
        "TURISMO_HOTELARIA", "DESPORTO", "OUTRA",
        "AGRONOMIA", "OUTRO"
      ]
    },
    "estado": {
      "type": "enumeration",
      "enum": ["draft", "review", "approved", "published", "archived", "hidden"],
      "default": "draft"
    },
    "autor": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::perfil.perfil"
    },
    "colaboradores": { "type": "json", "description": "⚠️ DEPRECATED — usar acessoCoreACL. Mantido por retrocompatibilidade." },
    "tags": { "type": "json" },
    "mediaUrls": { "type": "json" },
    "media": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images", "files", "videos"]
    },
    "repositorioUrl": { "type": "string", "description": "⚠️ DEPRECATED — usar repoUrl. Mantido por retrocompatibilidade." },
    "repoUrl": { "type": "string" },
    "demoUrl": { "type": "string" },
    "selo": {
      "type": "enumeration",
      "enum": ["publicado", "validado_mentor", "validado_instituicao", "excelencia"]
    },
    "visibilidade": {
      "type": "enumeration",
      "enum": ["publico", "privado"],
      "default": "publico"
    },
    "buscandoParceiros": { "type": "boolean", "default": false },
    "criadoEm": { "type": "datetime" },
    "motivoRejeicao": { "type": "string", "maxLength": 500 },
    "rejeitadoEm": { "type": "datetime" },
    "rejeitadoPor": { "type": "string", "maxLength": 500 },
    "isDemo": { "type": "boolean", "default": false }
  }
}
