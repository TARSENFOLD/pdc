{
  "kind": "collectionType",
  "collectionName": "partilhas",
  "info": {
    "singularName": "partilha",
    "pluralName": "partilhas",
    "displayName": "Partilha"
  },
  "options": {
    "draftAndPublish": false,
    "indexes": [
      {
        "name": "unique_internal_share_actor_target",
        "columns": ["actor", "targetType", "targetId", "canal"],
        "type": "unique"
      }
    ]
  },
  "attributes": {
    "actor": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::perfil.perfil",
      "required": true
    },
    "targetType": { "type": "string", "required": true },
    "targetId": { "type": "string", "required": true },
    "canal": {
      "type": "enumeration",
      "required": true,
      "default": "interno",
      "enum": ["interno", "whatsapp", "linkedin", "twitter", "email", "outro"]
    },
    "nota": { "type": "text", "maxLength": 500 },
    "criadoEm": { "type": "datetime" }
  }
}
