{
  "kind": "collectionType",
  "collectionName": "perfis",
  "info": {
    "singularName": "perfil",
    "pluralName": "perfis",
    "displayName": "Perfil",
    "description": "Perfil central do utilizador"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "nome": {
      "type": "string",
      "required": true
    },
    "tipo": {
      "type": "enumeration",
      "enum": [
        "estudante",
        "mentor",
        "instituicao",
        "moderador",
        "comite_cientifico",
        "super_admin",
        "patrocinador"
      ],
      "required": true
    },
    "email": {
      "type": "email"
    },
    "userId": {
      "type": "string"
    },
    "xp": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "ativo": {
      "type": "boolean",
      "default": true
    },
    "suspensaAte": {
      "type": "datetime"
    },
    "bio": {
      "type": "text",
      "maxLength": 1000
    },
    "headline": {
      "type": "string",
      "maxLength": 200
    },
    "foto": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "avatarUrl": {
      "type": "string"
    },
    "bannerUrl": {
      "type": "string"
    },
    "capa": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "telefone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "socialLinks": {
      "type": "json"
    },
    "areasInteresse": {
      "type": "json"
    },
    "competencias": {
      "type": "json"
    },
    "historicoProfissional": {
      "type": "json"
    },
    "formacaoAcademica": {
      "type": "json"
    },
    "areaFormacao": {
      "type": "string"
    },
    "regiao": {
      "type": "string"
    },
    "nivelEnsino": {
      "type": "string"
    },
    "anoAcademico": {
      "type": "string"
    },
    "funcao": {
      "type": "string"
    },
    "tipoInstituicao": {
      "type": "string"
    },
    "niveisEnsino": {
      "type": "json"
    },
    "modalidadeCusto": {
      "type": "string"
    },
    "natureza": {
      "type": "string"
    },
    "aprovado": {
      "type": "boolean",
      "default": true
    },
    "modoAcesso": {
      "type": "enumeration",
      "enum": ["individual", "institucional"],
      "default": "individual"
    },
    "codigoInstitucional": {
      "type": "string"
    },
    "instituicao": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::instituicao.instituicao"
    },
    "instituicaoGerida": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::instituicao.instituicao",
      "inversedBy": "gestores"
    },
    "conquistas": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::conquista.conquista",
      "inversedBy": "perfis"
    },
    "documentos": {
      "type": "json"
    },
    "dataNascimento": {
      "type": "date"
    },
    "estadoMenoridade": {
      "type": "enumeration",
      "enum": ["pendente", "adulto", "menor"],
      "default": "pendente"
    },
    "consentimentoEstado": {
      "type": "enumeration",
      "enum": ["pendente", "completo", "requer_reconsentimento", "bloqueado"],
      "default": "pendente"
    },
    "consents": {
      "type": "json"
    },
    "contaEstado": {
      "type": "enumeration",
      "enum": ["ativa", "anonimizada"],
      "default": "ativa"
    },
    "anonymizedAt": {
      "type": "datetime"
    },
    "legalTermsVersion": {
      "type": "string"
    },
    "legalPrivacyVersion": {
      "type": "string"
    },
    "legalDataProcessingVersion": {
      "type": "string"
    },
    "legalAcceptedAt": {
      "type": "datetime"
    },
    "guardianConsent": {
      "type": "json"
    },
    "notificationPreferences": {
      "type": "json"
    },
    "visibilitySettings": {
      "type": "json"
    },
    "preferenciasUi": {
      "type": "json"
    },
    "language": {
      "type": "string",
      "default": "pt-AO"
    },
    "reputacao": {
      "type": "integer",
      "default": 0,
      "min": 0,
      "max": 100
    },
    "conquistasCount": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "vinkulosCount": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "activeStudents": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "activePrograms": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "lti_context": {
      "type": "json"
    },
    "behavior_patterns": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::behavior-pattern.behavior-pattern",
      "mappedBy": "perfil"
    },
    "inscricoes": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::inscricao.inscricao",
      "mappedBy": "perfil"
    },
    "feedPosts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::feed-post.feed-post",
      "mappedBy": "autor"
    },
    "motivoRejeicao": {
      "type": "string",
      "maxLength": 500
    },
    "aprovadoEm": {
      "type": "datetime"
    },
    "aprovadoPor": {
      "type": "string",
      "maxLength": 255
    },
    "onboardingCompleto": {
      "type": "boolean",
      "default": true
    },
    "oauthVerified": {
      "type": "boolean",
      "default": false
    },
    "oauthProvider": {
      "type": "enumeration",
      "enum": ["google", "linkedin"]
    }
  }
}
