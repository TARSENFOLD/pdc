{
  "kind": "collectionType",
  "collectionName": "subscricoes",
  "info": {
    "singularName": "subscricao",
    "pluralName": "subscricoes",
    "displayName": "Subscrição"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "perfil": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::perfil.perfil"
    },
    "instituicao": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::instituicao.instituicao"
    },
    "tipo": {
      "type": "enumeration",
      "enum": ["individual", "institucional"]
    },
    "plano": {
      "type": "enumeration",
      "enum": ["gratuito", "premium", "institucional_basico", "institucional_premium"]
    },
    "limiteAlunos": { "type": "integer" },
    "ativa": { "type": "boolean", "default": true },
    "inicioEm": { "type": "datetime" },
    "fimEm": { "type": "datetime" },
    "valorPago": { "type": "decimal" },
    "moeda": { "type": "string" },
    "tier": {
      "type": "enumeration",
      "enum": ["free", "basic", "premium", "enterprise"],
      "default": "free"
    },
    "features": { "type": "json" },
    "quotas": { "type": "json" }
  }
}
