{
  "kind": "collectionType",
  "collectionName": "inscricoes",
  "info": {
    "singularName": "inscricao",
    "pluralName": "inscricoes",
    "displayName": "Inscrição"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "perfil": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::perfil.perfil",
      "required": true
    },
    "curso": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::curso.curso",
      "required": true
    },
    "role": {
      "type": "enumeration",
      "enum": ["aluno", "mentor"],
      "default": "aluno"
    },
    "dataInscricao": { "type": "date" },
    "progressoPercentual": { "type": "integer", "default": 0 },
    "modulosConcluidos": { "type": "json" },
    "ultimaAtividadeEm": { "type": "datetime" },
    "concluidoEm": { "type": "datetime" },
    "pago": { "type": "boolean", "default": false },
    "valorPago": { "type": "decimal" }
  }
}
