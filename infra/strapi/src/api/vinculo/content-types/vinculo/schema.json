{
  "kind": "collectionType",
  "collectionName": "vinculos",
  "info": {
    "singularName": "vinculo",
    "pluralName": "vinculos",
    "displayName": "Vínculo"
  },
  "options": {
    "draftAndPublish": false,
    "indexes": [
      {
        "name": "unique_vinculo_solicitante_destinatario_tipo",
        "columns": ["solicitante", "destinatario", "tipo"],
        "type": "unique"
      }
    ]
  },
  "attributes": {
    "senderId": { "type": "string", "required": true },
    "receiverId": { "type": "string", "required": true },
    "connectionType": { "type": "string" },
    "status": {
      "type": "enumeration",
      "enum": ["pendente", "aprovado", "rejeitado", "concluido"],
      "default": "pendente"
    },
    "solicitante": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::perfil.perfil"
    },
    "destinatario": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::perfil.perfil"
    },
    "tipo": {
      "type": "enumeration",
      "enum": ["aluno-mentor", "mentor-instituicao", "aluno-instituicao"]
    },
    "mensagem": { "type": "text", "maxLength": 300 },
    "documentoUrl": { "type": "string" },
    "visibleOnProfile": { "type": "boolean", "default": false },
    "criadoEm": { "type": "datetime" },
    "resolvidoEm": { "type": "datetime" },
    "dataTerminacao": { "type": "datetime" }
  }
}
