{
  "kind": "collectionType",
  "collectionName": "simulacoes",
  "info": {
    "singularName": "simulacao",
    "pluralName": "simulacoes",
    "displayName": "Simulação"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "titulo": { "type": "string", "required": true },
    "autorId": { "type": "string" },
    "tipo": { "type": "integer" },
    "slug": { "type": "uid", "targetField": "titulo", "unique": true },
    "nome": { "type": "string" },
    "descricao": { "type": "text" },
    "tipoSimulacao": {
      "type": "enumeration",
      "enum": ["tipo1", "tipo2", "tipo3"]
    },
    "nivel": {
      "type": "enumeration",
      "enum": ["basico", "medio", "avancado"]
    },
    "area": {
      "type": "enumeration",
      "enum": [
        "ENGENHARIA", "SAUDE", "TECNOLOGIA", "AGRONOMIA", "GESTAO",
        "EDUCACAO", "DIREITO", "CIENCIAS_SOCIAIS", "ARTES", "OUTRO"
      ]
    },
    "estado": {
      "type": "enumeration",
      "enum": ["draft", "review", "approved", "published", "archived"],
      "default": "draft"
    },
    "conteudoUrl": { "type": "string" },
    "criteriosAvaliacao": { "type": "json" },
    "executorConfig": { "type": "json" },
    "tentativasMaximas": { "type": "integer", "default": 0 },
    "materiaisInfo": { "type": "json" },
    "tags": { "type": "json" },
    "autor": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::perfil.perfil"
    },
    "instituicao": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::instituicao.instituicao"
    },
    "validadoAcademicamente": { "type": "boolean", "default": false },
    "comiteValidacao": { "type": "text" },
    "dataValidacao": { "type": "datetime" },
    "motivoRejeicao": { "type": "text" },
    "historicoEstados": { "type": "json" }
  }
}
