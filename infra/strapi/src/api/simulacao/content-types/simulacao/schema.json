{
  "kind": "collectionType",
  "collectionName": "simulacoes",
  "info": {
    "singularName": "simulacao",
    "pluralName": "simulacoes",
    "displayName": "Simulação"
  },
  "attributes": {
    "titulo": {
      "type": "string",
      "required": true
    },
    "descricao": {
      "type": "text"
    },
    "slug": {
      "type": "uid",
      "targetField": "titulo"
    },
    "tipo": {
      "type": "integer",
      "required": true,
      "min": 1,
      "max": 3
    },
    "capaUrl": {
      "type": "string"
    },
    "iframeUrl": {
      "type": "string"
    },
    "area": {
      "type": "string"
    },
    "visibilidade": {
      "type": "enumeration",
      "enum": ["publico", "privado"],
      "default": "publico"
    },
    "estado": {
      "type": "enumeration",
      "enum": ["draft", "review", "approved", "published", "archived"],
      "default": "draft",
      "required": true
    }
  }
}
