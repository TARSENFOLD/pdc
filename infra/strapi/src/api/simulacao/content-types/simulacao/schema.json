{
  "kind": "collectionType",
  "collectionName": "simulacoes",
  "info": {
    "singularName": "simulacao",
    "pluralName": "simulacoes",
    "displayName": "Simulação"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "titulo": { "type": "string", "required": true },
    "autorId": { "type": "string" },
    "tipo": { "type": "integer" },
    "slug": { "type": "uid", "targetField": "titulo", "unique": true },
    "nome": { "type": "string" },
    "descricao": { "type": "text" },
    "tipoSimulacao": {
      "type": "enumeration",
      "enum": ["tipo1", "tipo2", "tipo3"]
    },
    "nivel": {
      "type": "enumeration",
      "enum": ["basico", "medio", "avancado"]
    },
    "area": {
      "type": "enumeration",
      "enum": [
        "SAUDE", "ENGENHARIA", "TECNOLOGIA", "DIREITO", "GESTAO",
        "EDUCACAO", "ARTES", "CIENCIAS_AGRARIAS", "CIENCIAS_SOCIAIS",
        "COMUNICACAO", "CIENCIAS_NATURAIS", "ARQUITETURA",
        "TURISMO_HOTELARIA", "DESPORTO", "OUTRA"
      ]
    },
    "estado": {
      "type": "enumeration",
      "enum": ["draft", "review", "approved", "published", "archived"],
      "default": "draft"
    },
    "conteudoUrl": { "type": "string" },
    "criteriosAvaliacao": { "type": "json", "description": "Critérios de avaliação com pesos por dimensão (fluidez φ, resiliência R, foco)" },
    "executorConfig": { "type": "json" },
    "tentativasMaximas": { "type": "integer", "default": 0, "description": "0 = sem limite de tentativas" },
    "materiaisLab": { "type": "json", "description": "Materiais do laboratório de simulação" },
    "materiaisInfo": { "type": "json", "description": "⚠️ DEPRECATED — usar materiaisLab. Mantido por retrocompatibilidade." },
    "tipoLab": {
      "type": "enumeration",
      "enum": ["sandbox", "prova", "desafio", "experimento"],
      "description": "Tipo de laboratório da simulação"
    },
    "tags": { "type": "json" },
    "autor": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::perfil.perfil"
    },
    "instituicao": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::instituicao.instituicao"
    },
    "validadoAcademicamente": { "type": "boolean", "default": false },
    "comiteValidacao": { "type": "text" },
    "dataValidacao": { "type": "datetime" },
    "motivoRejeicao": { "type": "text" },
    "rejeitadoEm": { "type": "datetime" },
    "rejeitadoPor": { "type": "string" },
    "historicoEstados": { "type": "json" },
    "isDemo": { "type": "boolean", "default": false }
  }
}
