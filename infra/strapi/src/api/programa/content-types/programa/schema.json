{
  "kind": "collectionType",
  "collectionName": "programas",
  "info": {
    "singularName": "programa",
    "pluralName": "programas",
    "displayName": "Programa"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "titulo": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "titulo", "unique": true },
    "descricao": { "type": "text" },
    "proposito": { "type": "text" },
    "metodologia": { "type": "text" },
    "cronograma": { "type": "json" },
    "regrasMatricula": { "type": "json" },
    "precoPolicy": { "type": "json" },
    "criadorTipo": {
      "type": "enumeration",
      "enum": ["mentor", "instituicao"]
    },
    "instituicao": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::instituicao.instituicao"
    },
    "responsavel": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::perfil.perfil"
    },
    "cursos": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::curso.curso"
    },
    "experiencias": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::experiencia.experiencia"
    },
    "simulacoes": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::simulacao.simulacao"
    },
    "projetos": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::projeto.projeto"
    },
    "area": {
      "type": "enumeration",
      "enum": [
        "SAUDE", "ENGENHARIA", "TECNOLOGIA", "DIREITO", "GESTAO",
        "EDUCACAO", "ARTES", "CIENCIAS_AGRARIAS", "CIENCIAS_SOCIAIS",
        "COMUNICACAO", "CIENCIAS_NATURAIS", "ARQUITETURA",
        "TURISMO_HOTELARIA", "DESPORTO", "OUTRA"
      ]
    },
    "estado": {
      "type": "enumeration",
      "enum": ["draft", "published", "archived"],
      "default": "draft"
    },
    "modalidade": {
      "type": "enumeration",
      "enum": ["presencial", "online", "hibrido"]
    },
    "duracao": { "type": "string" },
    "vagas": { "type": "integer" },
    "requisitos": { "type": "text" },
    "tags": { "type": "json" },
    "tipo": {
      "type": "enumeration",
      "enum": ["standard", "shadowapro", "eduvisit"],
      "default": "standard"
    },
    "dataInicio": { "type": "datetime" },
    "dataFim": { "type": "datetime" },
    "metadata": { "type": "json" }
  }
}
