{
  "kind": "collectionType",
  "collectionName": "feed-posts",
  "info": {
    "singularName": "feed-post",
    "pluralName": "feed-posts",
    "displayName": "Feed Post"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "autor": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::perfil.perfil",
      "inversedBy": "feedPosts",
      "required": true
    },
    "corpo": {
      "type": "richtext",
      "required": true
    },
    "mediaUrls": {
      "type": "json",
      "description": "Array de URLs de mídia (imagens, vídeos)"
    },
    "estado": {
      "type": "enumeration",
      "enum": ["pendente_moderacao", "aprovada", "rejeitada", "hidden"],
      "default": "pendente_moderacao",
      "required": true
    },
    "motivoModeracao": {
      "type": "text",
      "description": "DEPRECATED: campo legado. Mapear valores existentes para motivoRejeicao ou motivoOcultacao conforme o estado do post."
    },
    "eventId": {
      "type": "string",
      "unique": true,
      "description": "ID único do evento para anti-duplicação"
    },
    "motivoRejeicao": {
      "type": "string",
      "maxLength": 500,
      "description": "Motivo usado quando o post é rejeitado."
    },
    "motivoOcultacao": {
      "type": "string",
      "maxLength": 500,
      "description": "Motivo usado quando o post é ocultado."
    },
    "rejeitadoEm": {
      "type": "datetime"
    },
    "rejeitadoPor": {
      "type": "string"
    },
    "likesCount": {
      "type": "integer",
      "default": 0
    },
    "comentariosCount": {
      "type": "integer",
      "default": 0
    }
  }
}
