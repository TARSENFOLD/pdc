{
  "kind": "collectionType",
  "collectionName": "experiencias",
  "info": {
    "singularName": "experiencia",
    "pluralName": "experiencias",
    "displayName": "Experiência"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "slug": { "type": "uid", "targetField": "titulo", "unique": true },
    "titulo": { "type": "string", "required": true },
    "descricao": { "type": "text" },
    "nivel": {
      "type": "enumeration",
      "enum": ["basico", "medio", "avancado"]
    },
    "area": {
      "type": "enumeration",
      "enum": [
        "SAUDE", "ENGENHARIA", "TECNOLOGIA", "DIREITO", "GESTAO",
        "EDUCACAO", "ARTES", "CIENCIAS_AGRARIAS", "CIENCIAS_SOCIAIS",
        "COMUNICACAO", "CIENCIAS_NATURAIS", "ARQUITETURA",
        "TURISMO_HOTELARIA", "DESPORTO", "OUTRA"
      ]
    },
    "estado": {
      "type": "enumeration",
      "enum": ["draft", "review", "approved", "published", "archived"],
      "default": "draft"
    },
    "visibilidade": {
      "type": "enumeration",
      "enum": ["publico", "privado", "institucional"],
      "default": "publico"
    },
    "curso": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::curso.curso"
    },
    "autor": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::perfil.perfil"
    },
    "instituicao": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::instituicao.instituicao"
    },
    "gratuito": { "type": "boolean", "default": true },
    "validadoAcademicamente": { "type": "boolean", "default": false },
    "painelRealidade": { "type": "json" },
    "muralVozes": { "type": "json" },
    "guiaInstitucional": { "type": "json" },
    "secoes": {
      "type": "json",
      "description": "Seções modulares de storytelling da Experiência; não são módulos pedagógicos de Curso"
    },
    "tags": { "type": "json" },
    "gradeDestaque": { "type": "json" },
    "telemetriaConfig": { "type": "json" },
    "vagas": { "type": "integer" },
    "duracaoEstimada": { "type": "integer", "description": "Duração estimada da experiência em horas" },
    "dataInicio": { "type": "datetime" },
    "dataFim": { "type": "datetime" },
    "localizacao": { "type": "string" },
    "modalidade": {
      "type": "enumeration",
      "enum": ["presencial", "online", "hibrido"]
    },
    "motivoRejeicao": { "type": "string", "maxLength": 500 },
    "rejeitadoEm": { "type": "datetime" },
    "rejeitadoPor": { "type": "string", "maxLength": 500 },
    "isDemo": { "type": "boolean", "default": false }
  }
}
