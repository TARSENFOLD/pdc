# ─── PDC v2 — Template de env para VPS Hetzner ───────────────────────────────
# Copia este ficheiro para /opt/pdc/.env no VPS e preenche com valores reais.
# NUNCA commites este ficheiro com valores reais.

# Core
NODE_ENV=production
PORT=3001
API_URL=https://api.usepdc.com
FRONTEND_URL=https://usepdc.com

# Strapi (BFF → Strapi)
STRAPI_URL=https://cms.usepdc.com
STRAPI_API_TOKEN=<your-strapi-api-token>
STRAPI_TIMEOUT=15000
STRAPI_WRITE_TIMEOUT=30000
JWT_SECRET=<your-jwt-secret-minimum-32-chars>

# Strapi (CMS interno)
DATABASE_URL=<neon-connection-string>
DATABASE_SSL=true
APP_KEYS=<key1>,<key2>,<key3>,<key4>
API_TOKEN_SALT=<your-api-token-salt>
ADMIN_JWT_SECRET=<your-admin-jwt-secret>
TRANSFER_TOKEN_SALT=<your-transfer-token-salt>

# Upstash Redis
UPSTASH_REDIS_REST_URL=<your-upstash-url>
UPSTASH_REDIS_REST_TOKEN=<your-upstash-token>

# Cloudflare R2
R2_ACCOUNT_ID=<your-r2-account-id>
R2_ACCESS_KEY_ID=<your-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<your-r2-secret-key>
R2_BUCKET=pdc-media
R2_PUBLIC_URL=<your-r2-public-url>

# AI: Deepseek
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=<your-deepseek-api-key>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Sentry
SENTRY_DSN=<your-sentry-dsn>
EDGE_PUBLIC_URL=https://edge.usepdc.com

# Rate limiting
RATE_LIMIT_PROFILE=strict
SEO_BOT_RENDER_ENABLED=true
TINA_RATE_LIMIT_PER_USER=20
TINA_RATE_LIMIT_GLOBAL=500

# Mail
RESEND_API_KEY=<your-resend-api-key>
RESEND_FROM_EMAIL=no-reply@usepdc.com

# SMS
TWILIO_ACCOUNT_SID=<your-twilio-account-sid>
TWILIO_AUTH_TOKEN=<your-twilio-auth-token>
TWILIO_PHONE_NUMBER=<your-twilio-phone-number>

# OAuth 2.0
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
GOOGLE_REDIRECT_URI=https://usepdc.com/auth/google/callback
LINKEDIN_CLIENT_ID=<your-linkedin-client-id>
LINKEDIN_CLIENT_SECRET=<your-linkedin-client-secret>
LINKEDIN_REDIRECT_URI=https://usepdc.com/auth/linkedin/callback
OAUTH_REDIRECT_BASE_URL=https://usepdc.com

# LTI
LTI_PRIVATE_KEY=<optional>
LTI_PUBLIC_KEY=<optional>
LTI_KEY_ID=pdc-lti-key-1
