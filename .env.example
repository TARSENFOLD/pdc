# ─── PDC v2: CONFIGURAÇÃO SOBERANA ───────────────────────────────────────────
# Secrets reais: /home/cj/Documentos/Notes/env.txt (local) ou Railway env (prod)
# NUNCA commitar valores reais — copie para .env e preencha com seus valores

# Core
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# Strapi (obrigatório em dev/prod)
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=<your-strapi-api-token>
STRAPI_TIMEOUT=15000
STRAPI_WRITE_TIMEOUT=30000
JWT_SECRET=<your-jwt-secret-minimum-32-chars>

# Upstash Redis (obrigatório em prod para OTP/rate-limit/cache)
UPSTASH_REDIS_REST_URL=https://example.upstash.io       # Required in production: OTP and rate-limit cache unavailable
UPSTASH_REDIS_REST_TOKEN=<your-upstash-token>           # Required in production: BFF Redis auth
UPSTASH_REDIS_REST_TOKEN_READONLY=<your-readonly-token> # Optional: read-only Redis access

# Cloudflare R2 Storage
R2_ACCOUNT_ID=<your-r2-account-id>        # Required in production: BFF boot fails without R2
R2_ACCESS_KEY_ID=<your-r2-access-key-id>  # Required in production: BFF boot fails without R2
R2_SECRET_ACCESS_KEY=<your-r2-secret-key> # Required in production: BFF boot fails without R2
R2_BUCKET=pdc-media
R2_PUBLIC_URL=https://media.example.com   # Required in production: media URLs unavailable

# AI: Deepseek (prod) + Ollama (dev/local)
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=<your-deepseek-api-key>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Sentry (Observabilidade)
SENTRY_DSN=https://xxx@oxx.ingest.sentry.io/xxx
EDGE_PUBLIC_URL=https://edge.example.com

# Segurança e Rate Limiting
RATE_LIMIT_PROFILE=strict
SEO_BOT_RENDER_ENABLED=true
TINA_RATE_LIMIT_PER_USER=20
TINA_RATE_LIMIT_GLOBAL=500

# Mail — prod exige pelo menos um provider: SendGrid OU Resend
SENDGRID_API_KEY=<your-sendgrid-api-key>  # Required in production: transactional email unavailable
SENDGRID_FROM_EMAIL=no-reply@example.com
RESEND_API_KEY=<your-resend-api-key>      # Required in production (if not using SendGrid)

# SMS — Twilio (OTP via SMS; prod exige credenciais válidas)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=<your-twilio-auth-token>
TWILIO_PHONE_NUMBER=+15005550006

# OAuth 2.0 (opcional em dev; configurar redirect URIs para prod)
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
LINKEDIN_CLIENT_ID=<your-linkedin-client-id>
LINKEDIN_CLIENT_SECRET=<your-linkedin-client-secret>
LINKEDIN_REDIRECT_URI=http://localhost:5173/auth/linkedin/callback
OAUTH_REDIRECT_BASE_URL=http://localhost:5173

# Database (opcional — Strapi é a camada primária)
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# Dev only
DEV_SKIP_OTP=false
