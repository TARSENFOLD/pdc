# ─────────────────────────────────────────────
# BFF — apps/api
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3001

# JWT
JWT_SECRET=change-me-in-production-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Strapi CMS
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=

# Upstash Redis (rate limiting + refresh tokens)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# LinkedIn OAuth 2.0
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3001/auth/linkedin/callback

# OAuth Redirect Base URL (Frontend)
OAUTH_REDIRECT_BASE_URL=http://localhost:3000

# SendGrid (email OTP)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@[dominio-pdc]

# Twilio (SMS OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# DeepSeek AI
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Tina Assistant
AI_PROVIDER=deepseek
TINA_RATE_LIMIT_PER_USER=20
TINA_RATE_LIMIT_GLOBAL=500

# Ollama (fallback IA local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# LTI 1.3
LTI_PRIVATE_KEY=
LTI_PUBLIC_KEY=
LTI_KEY_ID=pdc-lti-key-1

# Sentry
SENTRY_DSN=

# ─────────────────────────────────────────────
# Frontend — apps/web
# ─────────────────────────────────────────────
VITE_API_URL=http://localhost:3001
VITE_SENTRY_DSN=
