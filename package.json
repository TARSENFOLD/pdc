{
  "name": "pdc-v2",
  "version": "0.0.1",
  "private": true,
  "description": "Por Dentro do Curso — Monorepo v2",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/web",
    "apps/api",
    "apps/edge",
    "apps/mobile",
    "packages/shared",
    "infra/strapi"
  ],
  "scripts": {
    "prepare": "husky",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "concurrently -c \"blue,green,yellow\" \"npm run dev -w apps/web\" \"npm run dev -w apps/api\" \"npm run dev -w apps/edge\"",
    "test:load": "k6 run tests/k6/auth-flow.js",
    "test:load:auth": "k6 run tests/k6/auth-flow.js",
    "test:load:edge": "k6 run tests/k6/edge-load.js",
    "test:load:feed": "k6 run tests/k6/feed-load.js",
    "test:load:catalogo": "k6 run tests/k6/catalogo-browse.js",
    "test:load:journey": "k6 run tests/k6/full-journey.js",
    "test:load:stress": "k6 run tests/k6/stress-test.js",
    "test:load:discussions": "k6 run tests/k6/discussions-load.js",
    "test:load:telemetry": "k6 run tests/k6/telemetry-parallel.js",
    "test:load:spike": "k6 run tests/k6/spike-test.js",
    "test:load:soak": "k6 run tests/k6/soak-test.js",
    "test:e2e:smoke": "playwright test --project=smoke",
    "test:e2e:full": "playwright test --project=chromium --project=firefox",
    "test:e2e:docker": "docker run --rm --network host -v $(pwd):/work -w /work -e CI=true mcr.microsoft.com/playwright:v1.52.0-noble npx playwright test",
    "docker:load": "docker compose -f docker-compose.test.yml run --rm k6 run",
    "clean": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' + && find . -name 'dist' -type d -prune -exec rm -rf '{}' +",
    "test:e2e:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "validate:docs": "npx tsx scripts/validate-docs.ts",
    "lint:docs": "markdownlint-cli2 'docs/**/*.md' '.planning/**/*.md' 'specs/**/*.md' '*.md'"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "ajv-keywords": "^5.1.0",
    "axios": "^1.16.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "hono": "^4.12.18",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "lodash": "^4.18.1",
    "markdown-link-check": "^3.14.2",
    "markdownlint-cli2": "^0.22.1",
    "postcss": "^8.5.14",
    "prettier": "^3.3.0",
    "ts-morph": "^28.0.0",
    "typescript": "^5.5.0"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "esbuild": "^0.25.0",
    "hono": "^4.12.18",
    "@hono/node-server": "^1.19.13",
    "axios": "^1.16.0",
    "fast-uri": "^3.1.2",
    "fast-xml-builder": "^1.2.0",
    "fast-xml-parser": "^5.7.3",
    "markdown-it": "^14.1.1",
    "postcss": "^8.5.14",
    "vite": "^7.3.3",
    "@rushstack/node-core-library": {
      "ajv": "^8.18.0"
    },
    "@strapi/admin": {
      "axios": "^1.16.0"
    },
    "@strapi/cloud-cli": {
      "axios": "^1.16.0"
    },
    "@strapi/design-system": {
      "lodash": "^4.18.1"
    },
    "@vitejs/plugin-react-swc": "^4.3.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
